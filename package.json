{
  "name": "healthcare-ai-platform-plan",
  "version": "2.0.0",
  "description": "Executive rollout plan for a regulated healthcare AI coding platform using Codex, Kong, Bedrock, metering, and sanitized observability",
  "private": true,
  "type": "module",
  "homepage": "https://chief-builder.github.io/codex_rollout_healthcare/",
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "lint": "html-validate index.html codex_rollout_healthcare.html && node scripts/lint-markdown.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/**",
    "build": "node scripts/build-site.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chief-builder/codex_rollout_healthcare.git"
  },
  "bugs": {
    "url": "https://github.com/chief-builder/codex_rollout_healthcare/issues"
  },
  "license": "MIT",
  "keywords": [
    "codex",
    "healthcare",
    "bedrock",
    "kong",
    "mlflow",
    "governance"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "html-validate": "^11.16.2",
    "markdownlint": "^0.41.1",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.8.0"
  }
}
